#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ $# != 2 ]]; then
    printf 'Usage: %s IMAGE_ID DEK_BINARY\n' "$0" >&2
    exit 2
fi
scripts=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
fixture="$scripts/tests/arch-aur-fixture"
binary=$(realpath -e -- "$2")
run_root="${DEK_DEV_ROOT:-/data/dek-dev}/runs/48"
mkdir -p -- "$run_root"
evidence=$(mktemp -d "$run_root/aur-plan.XXXXXXXX")
printf 'Evidence %s\n' "$evidence"

run=''
cleanup() {
    if [[ -n "$run" ]]; then
        "$scripts/run-arch-vm" finish "$run" failed || true
    fi
}
trap cleanup EXIT
run=$("$scripts/run-arch-vm" start 48 "$1" "$binary")
printf '%s\n' "$run" > "$evidence/guest"
grep -F 'restrict=on' "$run/qemu.command" > "$evidence/offline"
local_digest=$(sha256sum -- "$binary")
remote_digest=$("$scripts/run-arch-vm" ssh "$run" sha256sum /usr/local/bin/dek)
[[ "${local_digest%% *}" == "${remote_digest%% *}" ]]
printf '%s\n' "$remote_digest" > "$evidence/binary.sha256"
"$fixture/setup" "$run" > "$evidence/setup.log" 2>&1
"$scripts/run-arch-vm" ssh "$run" /home/dek/aur-vm-fixture/publish dek-aur-unmanaged 1 > "$evidence/publish-unmanaged.log"
python3 "$fixture/confirm.py" "$run" -- dek-aur-fixture dek-aur-unmanaged > "$evidence/seed-builds.log" 2>&1

"$scripts/run-arch-vm" ssh "$run" sudo -n bash -s -- \
    < "$scripts/tests/arch-aur-plan-guest" 2>&1 | tee "$evidence/guest.log"
"$scripts/run-arch-vm" ssh "$run" sudo -n tar -C /var/tmp/dek-aur-plan -cf - evidence |
    tar -C "$evidence" -xf -
"$scripts/run-arch-vm" finish "$run" passed
run=''
