#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ $# != 3 ]]; then
    printf 'Usage: %s IMAGE_ID DEK_BINARY SIGNED_RIPGREP_ARCHIVE\n' "$0" >&2
    exit 2
fi
scripts=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
binary=$(realpath -e -- "$2")
archive=$(realpath -e -- "$3")
run_root="${DEK_DEV_ROOT:-/data/dek-dev}/runs/39"
mkdir -p -- "$run_root"
evidence=$(mktemp -d "$run_root/local-convergence.XXXXXXXX")
printf 'Evidence %s\n' "$evidence"
mkdir -- "$evidence/package"
cp -- "$archive" "$evidence/package/ripgrep.pkg.tar.zst"
cp -- "$archive.sig" "$evidence/package/ripgrep.pkg.tar.zst.sig"
sha256sum -- "$binary" "$evidence/package/"* > "$evidence/inputs.sha256"
ruby=$(realpath -e -- "$(command -v ruby)")
[[ "$ruby" == /nix/store/*/bin/ruby ]]
nix-store -qR "${ruby%/bin/ruby}" | sed 's,^/,,' > "$evidence/ruby-paths"

run=''
cleanup() {
    if [[ -n "$run" ]]; then
        "$scripts/run-arch-vm" finish "$run" failed || true
    fi
}
trap cleanup EXIT
run=$("$scripts/run-arch-vm" start 39 "$1" "$binary")
printf '%s\n' "$run" | tee "$evidence/run"
grep -F 'restrict=on' "$run/qemu.command" > "$evidence/offline-network"
remote_digest=$("$scripts/run-arch-vm" ssh "$run" sha256sum /usr/local/bin/dek)
local_digest=$(sha256sum -- "$binary")
[[ "${remote_digest%% *}" == "${local_digest%% *}" ]]
printf '%s\n' "$remote_digest" > "$evidence/guest-dek.sha256"

tar -C / -cf - -T "$evidence/ruby-paths" | gzip -1 |
    "$scripts/run-arch-vm" ssh "$run" sudo -n tar -xzpf - -C /
tar -C "$evidence/package" -cf - . |
    "$scripts/run-arch-vm" ssh "$run" 'sudo -n mkdir -m 0755 /run/dek-convergence-fixture && sudo -n tar --no-same-owner -xf - -C /run/dek-convergence-fixture'
"$scripts/run-arch-vm" ssh "$run" sudo -n env "PATH=/usr/local/bin:${ruby%/ruby}:/usr/bin" bash -s \
    < "$scripts/tests/local-convergence-guest" 2>&1 | tee "$evidence/guest.log"
"$scripts/run-arch-vm" finish "$run" passed
run=''
