#!/usr/bin/env bash
# Generate test ciphertext on the host, then exercise it inside a disposable Arch guest.
set -euo pipefail
export LC_ALL=C

first='dek fixture private bytes 37c0fa8e'
second='dek changed private bytes f924e761'

prepare() {
    local directory=$1 key recipient
    umask 077
    mkdir -p -- "$directory"
    for key in first second wrong; do
        age-keygen -o "$directory/$key.agekey" 2>/dev/null
    done
    recipient=$(age-keygen -y "$directory/first.agekey")
    printf '%s\n' "$first" | age -r "$recipient" -o "$directory/initial.age"
    recipient=$(age-keygen -y "$directory/second.agekey")
    printf '%s\n' "$first" | age -a -r "$recipient" -o "$directory/rekey.age"
    printf '%s\n' "$second" | age -r "$recipient" -o "$directory/changed.age"
    recipient=$(age-keygen -y "$directory/wrong.agekey")
    printf '%s\n' "$second" | age -r "$recipient" -o "$directory/wrong.age"
    python3 - "$directory" <<'PY'
import pathlib, sys
root = pathlib.Path(sys.argv[1])
data = bytearray((root / "changed.age").read_bytes())
data[-1] ^= 1
(root / "corrupt.age").write_bytes(data)
PY
    rm -- "$directory/wrong.agekey"
}

guest() {
    local payload=$1 inode run bad destination invocation manager_reloads
    [[ "$(id -u)" == 0 && -e /run/cloud-init/instance-data.json ]]
    grep -Fx 'ID=arch' /etc/os-release
    uname -r
    /usr/local/bin/dek --version

    repo=$(mktemp -d)
    export XDG_CACHE_HOME="$repo/cache"
    state="$repo/state"
    counter="$repo/reloads"
    unit=dek37-notice.service
    root=/srv/dek37-fixture
    output="$root/keys/id_deploy"
    identities="$repo/identities"
    archives="$repo/archive"
    mkdir -m 0700 -- "$identities" "$archives"
    tar -xf "$payload" -C "$archives"
    install -m 0600 -- "$archives/first.agekey" "$identities/first.agekey"
    install -m 0600 -- "$archives/second.agekey" "$identities/second.agekey"
    rm -- "$archives/first.agekey" "$archives/second.agekey"

    cat > "$repo/dek.json" <<'JSON'
{"schemaVersion":1,"hosts":{"fixture":{"target":{"local":true},"entry":"host.json"}},"modules":{"lab.age":{"schema":"options.json","expand":"expand.rb"}}}
JSON
    cat > "$repo/options.json" <<'JSON'
{"options":[{"path":"lab.age.file","type":"string","description":"Independent reload source"}]}
JSON
    cat > "$repo/expand.rb" <<'RUBY'
if (content = option("lab.age.file"))
  directory = File.dirname(__FILE__)
  unit = {scope: "system", name: "dek37-notice.service"}
  file_resource "#{directory}/ordinary.conf", content: content,
    notifications: [{unit: unit, effect: "reload", when: "contentChanged"}]
end
RUBY
    cat > "/etc/systemd/system/$unit" <<UNIT
[Unit]
Description=dek age fixture notification
[Service]
ExecStart=/usr/bin/sleep infinity
ExecReload=/usr/bin/bash $repo/reload.sh $repo
UNIT
    cat > "$repo/reload.sh" <<'SH'
if [[ -e "$1/fail-once" ]]; then
    rm -- "$1/fail-once"
    exit 23
fi
printf 'reload\n' >> "$1/reloads"
SH
    : > "$counter"
    systemctl daemon-reload
    systemctl start "$unit"

    entry initial.age first "$output"
    plan > "$repo/initial-plan.json"
    python3 - "$repo/initial-plan.json" <<'PY'
import json, sys
actions = json.load(open(sys.argv[1]))["actions"]
def kind(name):
    return [action for action in actions if name in action["kind"]]
deployment, = kind("deployAgeSecret")
directory, = kind("ensureDirectory")
user, = kind("ensureUser")
group, = kind("ensureGroup")
assert set(deployment["dependsOn"]) == {directory["id"], user["id"], group["id"]}
assert len(kind("notifyService")) == 1
PY
    apply_fresh "$repo/initial-plan.json"
    stat -c '%U:%G:%a' "$output"
    [[ "$(stat -c '%U:%G:%a' "$output")" == dek37_alice:dek37_research:600 ]]
    [[ "$(cat "$output")" == "$first" && "$(wc -l < "$counter")" == 1 ]]
    zero_plan

    inode=$(stat -c '%d:%i' "$output")
    entry rekey.age second "$output"
    plan > "$repo/rekey-plan.json"
    grep -q '应用时核对' "$repo/rekey-plan.json"
    apply_fresh "$repo/rekey-plan.json" | tee "$repo/rekey.log"
    grep -F '实际变更 0 项' "$repo/rekey.log"
    [[ "$(stat -c '%d:%i' "$output")" == "$inode" && "$(cat "$output")" == "$first" ]]
    [[ "$(wc -l < "$counter")" == 1 ]]
    zero_plan

    chmod 0640 "$output"
    plan > "$repo/mode-plan.json"
    python3 - "$repo/mode-plan.json" <<'PY'
import json, sys
[action] = json.load(open(sys.argv[1]))["actions"]
assert list(action["kind"]) == ["setAgeSecretAttributes"]
PY
    apply_fresh "$repo/mode-plan.json"
    [[ "$(stat -c '%d:%i:%a' "$output")" == "$inode:600" && "$(wc -l < "$counter")" == 1 ]]

    printf 'externally modified\n' > "$output"
    plan > "$repo/drift-plan.json"
    grep -q '漂移' "$repo/drift-plan.json"
    apply_fresh "$repo/drift-plan.json"
    [[ "$(cat "$output")" == "$first" && "$(wc -l < "$counter")" == 2 ]]

    entry changed.age second "$output"
    plan > "$repo/change-plan.json"
    apply_fresh "$repo/change-plan.json"
    [[ "$(cat "$output")" == "$second" && "$(wc -l < "$counter")" == 3 ]]
    zero_plan
    inode=$(stat -c '%d:%i' "$output")

    for bad in corrupt wrong; do
        entry "$bad.age" second "$output"
        plan > "$repo/$bad-plan.json"
        if apply_fresh "$repo/$bad-plan.json" > "$repo/$bad-out.log" 2> "$repo/$bad-error.log"; then
            printf 'Expected age authentication to fail for %s.\n' "$bad" >&2
            exit 1
        fi
        [[ "$(cat "$output")" == "$second" && "$(stat -c '%d:%i' "$output")" == "$inode" ]]
        systemctl is-active --quiet "$unit"
        [[ "$(wc -l < "$counter")" == 3 ]]
        [[ -z "$(find "$root" -name '.dek-stage-*' -print -quit)" ]]
    done

    entry rekey.age second "$output"
    plan > "$repo/retry-plan.json"
    touch "$repo/fail-once"
    if apply_fresh "$repo/retry-plan.json" > "$repo/retry-out.log" 2> "$repo/retry-error.log"; then
        printf 'Expected the first systemd reload job to fail.\n' >&2
        exit 1
    fi
    run=$(awk '$1 == "run_id" {print $2}' "$repo/retry-out.log")
    [[ -n "$run" ]]
    [[ "$(cat "$output")" == "$first" && "$(wc -l < "$counter")" == 3 ]]
    dek_command status --run "$run" --json > "$repo/pending-status.json"
    python3 - "$repo/pending-status.json" <<'PY'
import json, sys
status = json.load(open(sys.argv[1]))
notice, = status["pending_notifications"]
assert notice["unit"]["name"] == "dek37-notice.service"
last = status["actions"][-1]
assert last["result"]["failed"]["notificationJobFailed"] is True
PY
    inode=$(stat -c '%d:%i' "$output")
    dek_command apply --run "$run" | tee "$repo/retry-success.log"
    grep -Fx "run_id $run" "$repo/retry-success.log"
    [[ "$(stat -c '%d:%i' "$output")" == "$inode" && "$(wc -l < "$counter")" == 4 ]]
    zero_plan

    invocation=$(systemctl show "$unit" --property=InvocationID --value)
    manager_reloads=$(systemctl show --property=ReloadCount --value)
    entry initial.age first "$output" description
    plan > "$repo/description-plan.json"
    apply_fresh "$repo/description-plan.json"
    [[ "$(systemctl show --property=ReloadCount --value)" == "$((manager_reloads + 1))" ]]
    [[ "$(systemctl show "$unit" --property=InvocationID --value)" == "$invocation" ]]
    [[ "$(wc -l < "$counter")" == 4 ]]

    entry rekey.age second "$output" mixed
    plan > "$repo/mixed-plan.json"
    python3 - "$repo/mixed-plan.json" <<'PY'
import json, sys
actions = json.load(open(sys.argv[1]))["actions"]
notice, = (item["kind"]["notifyService"] for item in actions if "notifyService" in item["kind"])
assert notice["effect"] == "restart"
assert {source["effect"] for source in notice["sources"]} == {"restart", "reload"}
PY
    apply_fresh "$repo/mixed-plan.json"
    [[ "$(systemctl show "$unit" --property=InvocationID --value)" == "$invocation" ]]
    [[ "$(wc -l < "$counter")" == 5 ]]
    [[ "$(stat -c '%d:%i' "$output")" == "$inode" ]]
    dek_command status --json > "$repo/mixed-status.json"
    python3 - "$repo/mixed-status.json" <<'PY'
import json, sys
actions = json.load(open(sys.argv[1]))["actions"]
notice, = (item for item in actions if "notifyService" in item["action"]["kind"])
assert notice["action"]["kind"]["notifyService"]["effect"] == "restart"
assert notice["selectedNotificationEffect"] == "reload"
assert notice["result"]["verified"]["changed"] is True
PY
    zero_plan
    printf 'Ordering-only daemon reload and mixed source effects stayed isolated.\n'

    ln -s -- "$output" "$root/keys/link"
    for destination in "$root/keys/link" "$identities/second.agekey"; do
        entry changed.age second "$destination"
        if plan > "$repo/conflict-plan.json" 2> "$repo/conflict-error.log"; then
            printf 'Expected an age destination path conflict.\n' >&2
            exit 1
        fi
    done

    /usr/local/bin/dek --repo "$repo" -H fixture status --state-dir "$state" --json > "$repo/status.json"
    python3 - "$repo" "$XDG_CACHE_HOME" "$state" "$first" "$second" <<'PYTHON'
import pathlib, sys
repo, cache, state = map(pathlib.Path, sys.argv[1:4])
secret_markers = [value.encode() for value in sys.argv[4:]]
for path in [*repo.glob("*"), *cache.rglob("*"), *state.rglob("*")]:
    if path.is_file() and any(marker in path.read_bytes() for marker in secret_markers):
        raise SystemExit("Synthetic plaintext leaked outside the destination.")
PYTHON
    printf 'Age deploy, rotation, mode repair, content notifications, failure and plaintext scans passed.\n'
}

entry() {
    python3 - "$1" "$2" "$3" "$root" "$identities" "$unit" "${4:-normal}" "$repo" > "$repo/host.json" <<'PY'
import json, sys
ciphertext, identity, path, root, identities, unit, phase, repo = sys.argv[1:]
options = {
    "users.groups.dek37_research": {},
    "users.users.dek37_alice.isNormalUser": True,
    "users.users.dek37_alice.group": "dek37_research",
    "systemd.tmpfiles.settings.dek37": {
        root + "/keys": {"d": {"user": "dek37_alice", "group": "dek37_research", "mode": "0700"}},
    },
    "age.identityPaths": [identities + "/" + identity + ".agekey"],
    "age.secrets.test.file": "archive/" + ciphertext,
    "age.secrets.test.path": path,
    "age.secrets.test.owner": "dek37_alice",
    "age.secrets.test.group": "dek37_research",
    "age.secrets.test.mode": "0600",
    ("age.secrets.test.restartUnits" if phase == "mixed" else "age.secrets.test.reloadUnits"): [unit],
}
if phase in ("description", "mixed"):
    options["systemd.services"] = {
        unit.removesuffix(".service"): {
            "description": "Updated fixture unit definition",
            "serviceConfig": {
                "ExecStart": "/usr/bin/sleep infinity",
                "ExecReload": f"/usr/bin/bash {repo}/reload.sh {repo}",
            },
        },
    }
if phase == "mixed":
    options["lab.age.file"] = "an independent ordinary file update"
print(json.dumps({"schemaVersion": 1, "imports": [], "options": [
    {"path": key, "value": value} for key, value in options.items()
]}))
PY
}

dek_command() {
    local command=$1
    shift
    /usr/local/bin/dek --repo "$repo" -H fixture "$command" --state-dir "$state" "$@"
}
plan() { dek_command plan --json; }
apply_fresh() {
    local id
    id=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["plan_id"])' < "$1")
    dek_command apply --plan "$id"
}
zero_plan() {
    plan | python3 -c 'import json,sys; assert not json.load(sys.stdin)["actions"]'
}

case "${1-}" in
    prepare) prepare "$2" ;;
    guest) install -d -m 0755 /srv/dek37-fixture; guest "$2" ;;
    *) printf 'usage: %s {prepare DIR|guest ARCHIVE}\n' "$0" >&2; exit 2 ;;
esac
