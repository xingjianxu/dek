#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 2 ]]; then
    printf 'Usage: %s IMAGE_ID DEK_BINARY\n' "$0" >&2
    exit 2
fi

scripts=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
fixture="$scripts/../crates/dek-cli/tests/fixtures/platform-capabilities"
binary=$(realpath -e -- "$2")
run_root="${DEK_DEV_ROOT:-/data/dek-dev}/runs/51"
mkdir -p -- "$run_root"
evidence=$(mktemp -d "$run_root/platform-capabilities.XXXXXXXX")
printf 'Evidence %s\n' "$evidence"
ruby=$(realpath -e -- "$(command -v ruby)")
[[ "$ruby" == /nix/store/*/bin/ruby ]]
ruby_dir=${ruby%/ruby}
nix-store -qR "${ruby%/bin/ruby}" | sed 's,^/,,' > "$evidence/ruby-paths"

run=''
cleanup() {
    if [[ -n "$run" ]]; then
        "$scripts/run-arch-vm" finish "$run" failed || true
    fi
}
trap cleanup EXIT
run=$("$scripts/run-arch-vm" start 51 "$1" "$binary")
printf '%s\n' "$run" | tee "$evidence/run"

local_digest=$(sha256sum -- "$binary")
remote_digest=$("$scripts/run-arch-vm" ssh "$run" sha256sum /usr/local/bin/dek)
[[ "${local_digest%% *}" == "${remote_digest%% *}" ]]
printf '%s\n' "$remote_digest" > "$evidence/guest-dek.sha256"
grep -F 'restrict=on' "$run/qemu.command" > "$evidence/offline-network"

tar -C / -cf - -T "$evidence/ruby-paths" | gzip -1 |
    "$scripts/run-arch-vm" ssh "$run" sudo -n tar -xzpf - -C /
tar -C "$fixture" -cf - . |
    "$scripts/run-arch-vm" ssh "$run" 'mkdir -m 0700 /home/dek/platform-fixture && tar -xf - -C /home/dek/platform-fixture'

"$scripts/run-arch-vm" ssh "$run" env "PATH=/usr/local/bin:$ruby_dir:/usr/bin" bash -s \
    > "$evidence/plan.json" 2> >(tee "$evidence/guest.stderr" >&2) <<'GUEST'
set -euo pipefail
grep -qFx 'ID=arch' /etc/os-release
file=/run/dek-platform-review.conf
timer=/etc/systemd/system/dek-platform-review.timer
[[ ! -e "$file" && ! -e "$timer" ]]
dek --repo /home/dek/platform-fixture -H arch plan --json --state-dir /home/dek/platform-state
[[ ! -e "$file" && ! -e "$timer" ]]
GUEST

python3 - "$evidence/plan.json" "$fixture/source/demo.conf" <<'PY'
from hashlib import sha256
import json
from pathlib import Path
import sys

plan = json.loads(Path(sys.argv[1]).read_text())
digest = "sha256:" + sha256(Path(sys.argv[2]).read_bytes()).hexdigest()
assert plan["host"] == "arch", plan
assert plan["target"]["distribution"] == "arch", plan
assert len(plan["plan_id"]) == 64, plan
actions = [action["kind"] for action in plan["actions"]]
assert sorted(next(iter(kind)) for kind in actions) == ["deployUnit", "reloadManager", "writeFile"], actions
file = next(kind["writeFile"] for kind in actions if "writeFile" in kind)
assert file["path"] == "/run/dek-platform-review.conf", file
assert file["content"]["digest"] == digest, file
unit = next(kind["deployUnit"] for kind in actions if "deployUnit" in kind)
assert unit["unit"]["name"] == "dek-platform-review.timer", unit
print("Arch plan includes the declared file and conditionally imported timer.")
PY

"$scripts/run-arch-vm" finish "$run" passed
run=''
